{
  "name": "@red-cup-engineering/observing-git-repository-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reports a Git repository's root, branch, HEAD, and working-tree status.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/observing-git-repository-service.git"
  },
  "bin": {
    "observe-git-repository": "./scripts/observe-git-repository.mjs"
  },
